# Database (SQLite locally; use a postgresql:// URL in production and change the provider in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Public site URL (used for absolute links in newsletter exports)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin access — set both. The secret signs the admin session cookie.
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# Google AdSense (leave empty until your account is approved)
# Client ID looks like ca-pub-1234567890123456; ads.txt is generated from it.
NEXT_PUBLIC_ADSENSE_CLIENT=""
