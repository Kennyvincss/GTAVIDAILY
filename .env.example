# PostgreSQL. Locally: `docker compose up -d` starts one matching these URLs.
# In production use your provider's pooled URL for DATABASE_URL and the direct URL for DIRECT_URL
# (they can be identical if your provider has no connection pooler).
DATABASE_URL="postgresql://gvd:gvd@localhost:5432/gtavidaily"
DIRECT_URL="postgresql://gvd:gvd@localhost:5432/gtavidaily"

# Public site URL (used for absolute links in newsletter issues and the subscriber export)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin access — set both. The secret signs the admin session cookie (16+ characters).
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# Google AdSense (leave empty until your account is approved)
# Client ID looks like ca-pub-1234567890123456; ads.txt is generated from it.
NEXT_PUBLIC_ADSENSE_CLIENT=""

# Enables the daily scheduled import (/api/cron/import). Vercel sends it automatically when set.
CRON_SECRET=""
